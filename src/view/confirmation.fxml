<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!-- Artboard "5 · Ordine confermato" -->
<StackPane styleClass="pattern-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ConfirmationController">
    <padding><Insets top="64" right="32" bottom="64" left="32" /></padding>
    <VBox styleClass="panel" spacing="20" alignment="TOP_CENTER" maxWidth="560" maxHeight="-Infinity" style="-fx-padding: 48px;">
        <StackPane fx:id="checkCircle" styleClass="success-circle" />
        <VBox spacing="6" alignment="CENTER">
            <Label fx:id="number" styleClass="caption" />
            <Label text="Ordine confermato!" styleClass="display" />
            <Label fx:id="message" styleClass="subtitle" wrapText="true" />
        </VBox>
        <VBox fx:id="recap" styleClass="inset" spacing="10" maxWidth="Infinity" />
        <GridPane hgap="12" maxWidth="Infinity">
            <columnConstraints><ColumnConstraints percentWidth="50" /><ColumnConstraints percentWidth="50" /></columnConstraints>
            <Button text="I miei ordini" styleClass="btn-secondary, btn-lg" maxWidth="Infinity" onAction="#orders" />
            <Button text="Torna alla home" styleClass="btn-lg" maxWidth="Infinity" GridPane.columnIndex="1" onAction="#home" />
        </GridPane>
    </VBox>
</StackPane>
