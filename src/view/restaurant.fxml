<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!-- Artboard "3 · Ristorante + carrello" -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RestaurantController" alignment="TOP_CENTER">
    <VBox spacing="24" maxWidth="1240">
        <padding><Insets top="24" right="32" bottom="56" left="32" /></padding>
        <Button fx:id="backLink" text="Tutti i ristoranti" styleClass="back-link" onAction="#back" />

        <HBox styleClass="section-card" spacing="28" alignment="CENTER_LEFT">
            <StackPane fx:id="logo" />
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label fx:id="name" styleClass="display" wrapText="true" />
                <Label fx:id="description" styleClass="subtitle" wrapText="true" />
                <HBox fx:id="meta" spacing="20" alignment="CENTER_LEFT" />
            </VBox>
        </HBox>

        <HBox fx:id="tabs" spacing="8" />

        <HBox spacing="32" alignment="TOP_LEFT">
            <VBox fx:id="menu" spacing="32" HBox.hgrow="ALWAYS" minWidth="0" />
            <VBox fx:id="cartPanel" styleClass="panel" spacing="16" minWidth="360" prefWidth="380" maxWidth="380" />
        </HBox>
    </VBox>
</StackPane>
