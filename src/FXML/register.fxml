<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="registerRoot" fx:id="registerRoot" prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../CSS/SceneCSS.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.RegisterController">

    <VBox fx:id="mainContainer" alignment="CENTER" layoutX="236.0" layoutY="124.8" maxWidth="746.0" minWidth="546.0" prefHeight="714.0" prefWidth="746.0" spacing="20" AnchorPane.bottomAnchor="241.0" AnchorPane.leftAnchor="236.0" AnchorPane.topAnchor="125.0">


    <Label styleClass="label" text="Registrazione su Food Delivery🍕" />

        <TextField fx:id="usernameField" promptText="Username" />
        <TextField fx:id="emailField" promptText="Email" />

        <StackPane alignment="CENTER_RIGHT">
            <PasswordField fx:id="passwField" promptText="Password" />
            <TextField fx:id="passwordVisibleField" managed="false" promptText="Password" visible="false" />
            <Button fx:id="toggleButton" onAction="#togglePasswordVisibility" styleClass="toggle-eye">
                <graphic>
                    <ImageView fx:id="toggleIcon" fitHeight="20" fitWidth="20" />
                </graphic>
            </Button>
        </StackPane>

        <StackPane alignment="CENTER_RIGHT">
            <PasswordField fx:id="confirmPasswField" promptText="Conferma Password" />
            <TextField fx:id="confirmPasswordVisibleField" managed="false" promptText="Conferma Password" visible="false" />
            <Button fx:id="toggleConfirmButton" onAction="#toggleConfirmPasswordVisibility" styleClass="toggle-eye">
                <graphic>
                    <ImageView fx:id="confirmToggleIcon" fitHeight="20" fitWidth="20" />
                </graphic>
            </Button>
        </StackPane>

        <Label fx:id="statusLabel" styleClass="info-label" textFill="red" />

        <Button onAction="#handlerRegister" prefWidth="200" text="Registrati" />
        <Hyperlink onAction="#handleBackToLogin" text="Torna a Login" />
    </VBox>
</AnchorPane>
