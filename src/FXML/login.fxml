<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="loginRoot" fx:id="loginRoot" prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../CSS/SceneCSS.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.LoginController">

    <VBox fx:id="mainContainer" alignment="CENTER" layoutX="236.0" layoutY="215.0" maxWidth="545.0" minWidth="504.0" prefHeight="624.0" prefWidth="504.0" spacing="20" AnchorPane.bottomAnchor="241.0" AnchorPane.leftAnchor="236.0" AnchorPane.topAnchor="215.0">

        <Label styleClass="label" text="Benvenuto su Food Delivery🍕" />
        <TextField fx:id="emailField" promptText="Email" />

        <StackPane alignment="CENTER_RIGHT">
            <PasswordField fx:id="passwField" promptText="Password" />
            <TextField fx:id="passwordVisibleField" managed="false" promptText="Password" visible="false" />
            <Button fx:id="toggleButton" onAction="#togglePasswordVisibility" styleClass="toggle-eye">
                <graphic>
                    <ImageView fx:id="toggleIcon" fitHeight="20" fitWidth="20" />
                </graphic>
            </Button>
        </StackPane>

        <Button onAction="#handleLogin" prefWidth="200" text="Login" />
        <Label fx:id="statusLabel" styleClass="info-label" textFill="red" />
        <Hyperlink onAction="#openRegisterPage" text="Registrati" />
        <Hyperlink onAction="#handleResetPassword" text="Password dimenticata?" />
    </VBox>
</AnchorPane>
